<UserControl x:Class="OpenCube.Controls.SeverityBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="22" Height="22" Background="Transparent" Cursor="Help" VerticalAlignment="Center"
             ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
    <UserControl.ToolTip>
        <ToolTip MaxWidth="380" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="Header" FontWeight="SemiBold" />
                <TextBlock x:Name="Body" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </ToolTip>
    </UserControl.ToolTip>
    <ui:SymbolIcon x:Name="Icon" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
</UserControl>
