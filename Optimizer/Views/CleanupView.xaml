<UserControl x:Class="OpenCube.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:OpenCube.Controls"
             xmlns:svc="clr-namespace:OpenCube.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Limpieza segura" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Opacity="0.7" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Primero se analiza y ves exactamente qué archivos se borrarían. No se borra nada hasta que lo confirmes. Solo se tocan archivos con más de 24 horas sin modificarse." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button x:Name="AnalyzeButton" Content="Analizar" Appearance="Primary"
                       Icon="{ui:SymbolIcon Search24}" Click="OnAnalyze" />
            <ui:Button x:Name="ExclusionsButton" Content="Exclusiones" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon ShieldProhibited24}" Click="OnToggleExclusions" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.8" />
        </StackPanel>

        <Border x:Name="ExclusionsPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12" Padding="16,12"
                CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="Carpetas que nunca se tocan" FontWeight="SemiBold" />
                <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap"
                           Text="Los archivos dentro de estas carpetas se ignoran al analizar. Vuelve a analizar después de cambiarlas." />
                <ItemsControl x:Name="ExclusionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Path}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                <TextBlock Grid.Column="1" Text="predeterminada" Opacity="0.5" FontSize="12"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Grid.Column="1" Content="Quitar" Appearance="Transparent" Padding="8,2"
                                           Click="OnRemoveExclusion"
                                           Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="Añadir carpeta…" Margin="0,8,0,0" Icon="{ui:SymbolIcon FolderAdd24}"
                           Click="OnAddExclusion" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanSelect}" MinWidth="0" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ctl:SeverityBadge Severity="{Binding Severity}" Message="{Binding Warning}"
                                                               Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Opacity="0.6" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding SizeText}" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CountText}" Opacity="0.6" FontSize="12"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                                <ui:Button Content="{Binding ToggleText}" Appearance="Transparent" Padding="6,2"
                                           Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnToggleFiles"
                                           Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding TopFiles}" Margin="0,6,0,0"
                                              Visibility="{Binding ShowFiles, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.75"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12"
                                                           Opacity="0.75" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid x:Name="TotalBar" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TotalText" VerticalAlignment="Center" FontSize="15" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ctl:SeverityBadge Severity="High" Margin="0,0,8,0"
                                       Message="El borrado es permanente: los archivos NO van a la papelera y no se pueden recuperar. Se elimina exactamente la lista de la vista previa (solo archivos con más de 24 horas y fuera de tus exclusiones). Antes de confirmar, revisa las categorías marcadas." />
                    <ui:Button x:Name="DeleteButton" Content="Eliminar seleccionado…"
                               Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Click="OnDeleteClick" />
                </StackPanel>
            </Grid>

            <Border x:Name="ConfirmPanel" Visibility="Collapsed" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="#C42B1C" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontSize="14" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Sí, eliminar" Appearance="Danger" Click="OnConfirm" Margin="0,0,8,0" />
                        <ui:Button Content="Cancelar" Click="OnCancel" Margin="0,0,10,0" />
                        <ctl:SeverityBadge Severity="High"
                                           Message="Último aviso: al confirmar, los archivos se borran de forma permanente (no van a la papelera). Si no estás seguro de una categoría, pulsa Cancelar, desmárcala y vuelve a intentarlo." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="Busy" Visibility="Collapsed" IsIndeterminate="True" Height="4"
                         VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
