<UserControl x:Class="OpenCube.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:OpenCube.Controls"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Programas de inicio" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ctl:SeverityBadge Severity="Medium" Margin="12,6,0,0"
                               Message="Desactivar un programa de inicio impide que arranque con Windows, pero no lo desinstala. Ojo con el antivirus y con controladores o utilidades de audio, ratón, teclado o tarjeta gráfica: si los desactivas, pueden dejar de funcionar hasta que los abras a mano. Puedes volver a activarlos en cualquier momento." />
        </StackPanel>
        <TextBlock x:Name="Summary" Grid.Row="1" Opacity="0.7" Margin="0,4,0,16" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Source}" Opacity="0.55" FontSize="12"
                                                   Margin="10,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Command}" Opacity="0.6" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                 IsEnabled="{Binding CanToggle}"
                                                 Click="OnToggleClick" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="ErrorBar" Grid.Row="2" VerticalAlignment="Bottom" Visibility="Collapsed"
                Padding="16,12" CornerRadius="8" Background="#B3C42B1C">
            <TextBlock x:Name="ErrorText" Foreground="White" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
