<UserControl x:Class="OpenCube.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:OpenCube.Controls"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Programas" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ctl:SeverityBadge Severity="Medium" Margin="12,6,0,0"
                                   Message="Desinstalar elimina un programa de tu equipo. En los programas normales se abre el desinstalador oficial y confirmas allí; sus archivos y datos pueden o no borrarse según cada programa. En las aplicaciones de la Tienda se quitan directamente de tu usuario. Esta pantalla nunca desinstala nada sin que pulses «Desinstalar» y confirmes." />
            </StackPanel>
            <TextBlock x:Name="Subtitle" Opacity="0.7" Margin="0,4,0,16" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBox x:Name="Search" Width="260" PlaceholderText="Buscar programa…" TextChanged="OnFilterChanged" />
            <ComboBox x:Name="Sort" Width="190" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Ordenar por nombre" />
                <ComboBoxItem Content="Ordenar por tamaño" />
                <ComboBoxItem Content="Ordenar por fecha" />
            </ComboBox>
            <ui:Button x:Name="RefreshButton" Content="Actualizar" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRefresh" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.8" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Tienda" FontSize="11" Opacity="0.6" Margin="8,2,0,0"
                                                   Visibility="{Binding IsStore, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Grid.Column="2" Text="{Binding DateText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                                <ui:Button Grid.Column="3" Content="Desinstalar…" Margin="16,0,0,0" Click="OnUninstallClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="ConfirmPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,8,0,0" Padding="16" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="#C42B1C" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontSize="14" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Sí, continuar" Appearance="Danger" Click="OnConfirm" Margin="0,0,8,0" />
                    <ui:Button Content="Cancelar" Click="OnCancel" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
