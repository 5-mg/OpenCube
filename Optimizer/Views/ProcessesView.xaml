<UserControl x:Class="OpenCube.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:OpenCube.Controls"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Procesos secundarios" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ctl:SeverityBadge Severity="Medium" Margin="12,6,0,0"
                                   Message="Cerrar un proceso lo detiene al instante. Si el programa tenía trabajo sin guardar, se pierde; los que tienen ventana reciben primero una petición normal de cierre. Es temporal: volverán a abrirse si están en Programas de inicio. Los procesos del sistema, el antivirus y esta propia aplicación nunca aparecen en la lista." />
            </StackPanel>
            <TextBlock Opacity="0.7" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Procesos en segundo plano que casi nunca hacen falta: actualizadores, lanzadores y servicios auxiliares. Marca los que quieras cerrar; nada se cierra hasta que confirmes." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="Actualizar" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRefresh" />
            <ui:Button Content="Marcar sugeridos" Margin="8,0,0,0" Click="OnSelectSuggested" />
            <CheckBox x:Name="ShowOthers" Content="Mostrar también otros procesos" Margin="14,0,0,0" Click="OnRefresh" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.8" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TagText}" FontSize="11" Margin="10,2,0,0" Foreground="{Binding TagBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Reason}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.5" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid x:Name="TotalBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TotalText" VerticalAlignment="Center" FontSize="15" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ctl:SeverityBadge Severity="Medium" Margin="0,0,8,0"
                                       Message="Va a cerrar los procesos marcados. Los que tienen ventana reciben una petición normal de cierre (pueden preguntar si guardar); los de segundo plano se detienen al instante. Si algo tenía trabajo sin guardar, se pierde." />
                    <ui:Button x:Name="CloseButton" Content="Cerrar seleccionados…" Appearance="Danger" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <Border x:Name="ConfirmPanel" Visibility="Collapsed" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="#C42B1C" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontSize="14" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button x:Name="ConfirmYes" Content="Sí, cerrar" Appearance="Danger" Click="OnConfirm" Margin="0,0,8,0" />
                        <ui:Button Content="Cancelar" Click="OnCancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
