<UserControl x:Class="OpenCube.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:OpenCube.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Analizador de disco" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ctl:SeverityBadge Severity="Low" Margin="12,6,0,0"
                                   Message="Solo lectura: esta pantalla nunca borra nada. Recorre las carpetas para calcular cuánto ocupa cada una; en discos grandes puede tardar varios minutos y usa bastante el disco mientras tanto. Los tamaños son aproximados." />
            </StackPanel>
            <TextBlock Opacity="0.7" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Descubre qué carpetas y archivos ocupan más espacio. Haz clic en una carpeta para entrar en ella." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="Locations" Width="300" DisplayMemberPath="Label" />
            <ui:Button Content="Elegir carpeta…" Margin="8,0,0,0" Click="OnPickFolder" />
            <ui:Button x:Name="AnalyzeButton" Content="Analizar" Appearance="Primary" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Search24}" Click="OnAnalyze" />
            <ui:Button x:Name="CancelButton" Content="Cancelar" Margin="8,0,0,0" Visibility="Collapsed" Click="OnCancel" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.8" />
        </StackPanel>

        <Grid Grid.Row="2" x:Name="Crumb" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="UpButton" Content="← Subir" Click="OnUp" />
            <TextBlock x:Name="PathText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TotalText" Grid.Column="2" VerticalAlignment="Center" Opacity="0.8" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="FoldersHeader" Text="Carpetas" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,8"
                           Visibility="Collapsed" />
                <ItemsControl x:Name="Folders">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                       Padding="12,8" Margin="0,0,0,2" Click="OnFolderClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FilesText}" Opacity="0.55" FontSize="11" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6"
                                                 Margin="12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" />
                                </Grid>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="OwnFilesText" Opacity="0.6" FontSize="12" Margin="12,6,0,0" />

                <TextBlock x:Name="BigHeader" Text="Archivos más grandes aquí (50 MB o más)" FontSize="16" FontWeight="SemiBold"
                           Margin="0,20,0,8" Visibility="Collapsed" />
                <ItemsControl x:Name="BigFiles">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                <ui:Button Grid.Column="2" Content="Mostrar" Appearance="Transparent" Padding="8,2" Margin="8,0,0,0"
                                           Click="OnShowInExplorer" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
