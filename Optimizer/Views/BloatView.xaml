<UserControl x:Class="OpenCube.Views.BloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:OpenCube.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Software innecesario" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ctl:SeverityBadge Severity="Medium" Margin="12,6,0,0"
                                   Message="Es una lista curada y puede equivocarse: solo sugiere, nunca elimina nada por su cuenta. Cada resultado explica por qué aparece y qué tan seguro es. Si no reconoces o no estás seguro de un programa, no lo quites; algo puede parecer innecesario y ser justo lo que otra aplicación necesita." />
            </StackPanel>
            <TextBlock Opacity="0.7" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Busca programas y aplicaciones que mucha gente no necesita: promociones preinstaladas, pruebas de antivirus, barras de herramientas, software descontinuado o con fallos de seguridad conocidos." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button x:Name="ScanButton" Content="Buscar software innecesario" Appearance="Primary"
                       Icon="{ui:SymbolIcon Search24}" Click="OnScan" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.8" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="●" Foreground="{Binding ConfidenceBrush}" Margin="10,1,4,0" />
                                        <TextBlock Text="{Binding ConfidenceText}" FontSize="12" Opacity="0.8" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Reason}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Source}" Opacity="0.5" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="Quitar…" VerticalAlignment="Center" Margin="16,0,0,0" Click="OnRemoveClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="ConfirmPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,8,0,0" Padding="16" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="#C42B1C" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontSize="14" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Sí, continuar" Appearance="Danger" Click="OnConfirm" Margin="0,0,8,0" />
                    <ui:Button Content="Cancelar" Click="OnCancel" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
