<ui:FluentWindow x:Class="OpenCube.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctl="clr-namespace:OpenCube.Controls"
                 Title="OpenCube"
                 Icon="pack://application:,,,/Assets/opencube.ico"
                 Width="1000" Height="650" MinWidth="760" MinHeight="500"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OpenCube" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Sidebar" Grid.Column="0" Width="192" Margin="12,8,6,12" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:Button x:Name="ToggleSidebar" Grid.Row="0" HorizontalAlignment="Left" Appearance="Transparent"
                           Margin="0,0,0,8" ToolTip="Mostrar u ocultar los nombres" Click="ToggleSidebar_Click" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel x:Name="NavPanel" /> <!-- buttons are created in code from the page list -->
                </ScrollViewer>

                <Grid x:Name="AdminRow" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="AdminButton" Content="Administrador"
                               Icon="{ui:SymbolIcon ShieldKeyhole24}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Click="AdminButton_Click" />
                    <ctl:SeverityBadge x:Name="AdminBadge" Grid.Column="1" Severity="Medium" Margin="6,0,0,0"
                                       Message="Va a reiniciar OpenCube con permisos de administrador (Windows te pedirá confirmación). Con esos permisos la app puede modificar archivos del sistema, así que úsalo solo para limpiar los temporales de Windows o crear un punto de restauración, y revisa bien la lista antes de borrar." />
                </Grid>
                <TextBlock x:Name="AdminLabel" Grid.Row="2" Text="Modo administrador" Opacity="0.6" FontSize="12"
                           Margin="8,0,0,4" VerticalAlignment="Bottom" Visibility="Collapsed" />
            </Grid>

            <ContentControl x:Name="Host" Grid.Column="1" Margin="12,8,24,16" />
        </Grid>
    </Grid>
</ui:FluentWindow>
